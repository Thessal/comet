Behavior Feynman(
    x1 : DataFrame, 
    x2 : DataFrame, 
    x3 : DataFrame, 
    x4 : DataFrame, 
    one : DataFrame
) {
    weights="weights/feynman_1.pth", train=true, supervised_epochs=100,
    operators = [add, subtract, divide, multiply, flip ], 
    integers = [ ], floats = [ 0.0, 1.0 ], strings=[], datadir="./data_feynman", metric="mse"
} -> DataFrame

Flow financialratio_example {
    x1 = data("x1")
    x2 = data("x2")
    x3 = data("x3")
    x4 = data("x4")
    one = data("one")
    Feynman(x1, x2, x3, x4, one)
}
